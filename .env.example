# Copy this file to .env for local reference (it is gitignored - .env is
# never committed). The real values must also be set in Vercel:
# Project Settings -> Environment Variables -> add both for Production,
# Preview, and Development. Vercel runs `npm run build` on every deploy,
# which reads these and writes them into config.js (also gitignored).
#
# Both values here are already safe to expose in a browser (the anon key is
# meant to be public; access is enforced by Supabase Row Level Security, see
# supabase/schema.sql) - this file just keeps them out of the source files
# and out of grep/history by convention, not because they're a secret.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
